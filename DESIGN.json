  "narrative": {
    "northStar": "The Operator's Panel",
    "overview": "Gatewarden is a calm control surface for self-hosted operators. It favors neutral foundations, precise hierarchy, and restrained interaction patterns so the interface supports incident reading, rule review, and host coverage checks without visual drama.",
    "keyCharacteristics": [
      "calm neutral-first surfaces",
      "strong hierarchy through contrast and spacing",
      "status color used as signal only",
      "familiar app-shell interaction model",
      "evidence-first operational scanning"
    ],
    "rules": [
      {
        "name": "The Status-Only Accent Rule",
        "body": "Semantic colors are reserved for operational meaning and should not decorate large generic surfaces.",
        "section": "colors"
      },
      {
        "name": "The Monospace Is Evidence Rule",
        "body": "Monospace is used for hostnames, paths, rule IDs, request IDs, and other machine-adjacent evidence only.",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Surfaces should feel architected, not floating. Prefer border and tone before stronger elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the base palette neutral-first.",
      "Do use monospace for operational evidence.",
      "Do make unprotected hosts and failed requests visible immediately.",
      "Do use spacing rhythm based on 12px, 16px, and 24px."
    ],
    "donts": [
      "Don't use neon or cyberpunk security styling.",
      "Don't recreate heavy enterprise security dashboards.",
      "Don't use gradient-first marketing aesthetics.",
      "Don't fall back to repetitive template-like admin grids.",
